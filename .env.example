# GEMINI_API_KEY: Optional/primary server-side Gemini AI API key.
# Never expose this key in client-side code.
GEMINI_API_KEY=

# GROQ_API_KEY: Optional Groq API key (used when Groq is selected or as automatic fallback on Gemini rate limits).
# Never expose this key in client-side code.
GROQ_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=
